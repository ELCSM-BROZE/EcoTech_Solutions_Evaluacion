# Copia este archivo como .env y reemplaza los valores con los de TU instancia.
ORACLE_USER=tu_usuario
ORACLE_PASSWORD=tu_contrasena
# Ejemplo de formato: localhost:1521/FREEPDB1
ORACLE_DSN=host:puerto/servicio

# Clave de API de tu cuenta WeatherAPI.com; no la compartas ni la subas a Git.
WEATHERAPI_API_KEY=
WEATHERAPI_DEFAULT_CITY=Santiago
